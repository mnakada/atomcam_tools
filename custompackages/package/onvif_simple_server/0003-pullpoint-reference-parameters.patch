 shm_t *subs_evts;
 
+static int get_subscription_id(const char *method)
+{
+    int qs_size;
+    char *qs_string;
+    char *sub_id_s;
+    const char *sub_id_ref;
+    int sub_id;
+
+    get_from_query_string(&qs_string, &qs_size, "sub");
+    if ((qs_size != -1) && (qs_string != NULL)) {
+        sub_id_s = (char *) malloc((qs_size + 1) * sizeof(char));
+        if (sub_id_s == NULL) {
+            log_error("Unable to allocate subscription id buffer for %s method", method);
+            return -1;
+        }
+        memset(sub_id_s, '\0', qs_size + 1);
+        strncpy(sub_id_s, qs_string, qs_size);
+        sub_id = atoi(sub_id_s);
+        free(sub_id_s);
+    } else {
+        sub_id_ref = get_element("SubscriptionId", "Header");
+        if (sub_id_ref == NULL) {
+            log_error("No subscription id for %s method", method);
+            return -1;
+        }
+        sub_id = atoi(sub_id_ref);
+    }
+
+    if ((sub_id <= 0) || (sub_id > 65535)) {
+        log_error("Subscription id %d out of range for %s method", sub_id, method);
+        return -1;
+    }
+
+    log_debug("Subscription id %d for %s method", sub_id, method);
+    return sub_id;
+}
