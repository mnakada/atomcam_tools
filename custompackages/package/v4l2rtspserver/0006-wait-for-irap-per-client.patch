+/* ---------------------------------------------------------------------------
+** WaitForIRAPFilter.h
+**
+** Per-client filter: a new RTSP client is attached to the shared stream at
+** "now", i.e. usually in the middle of a GOP. Decoders (VAAPI in particular)
+** then choke on the leading P frames whose references they never received.
+** Pass parameter sets and everything else, but drop coded slices until the
+** first IRAP picture, so every client starts on a keyframe.
+** -------------------------------------------------------------------------*/
+
+#pragma once
+
+#include "logger.h"
+
+class WaitForIRAPFilter : public FramedFilter {
+	public:
+		static WaitForIRAPFilter* createNew(UsageEnvironment& env, FramedSource* inputSource, bool hevc) {
+			return new WaitForIRAPFilter(env, inputSource, hevc);
+		}
+
+	protected:
+		WaitForIRAPFilter(UsageEnvironment& env, FramedSource* inputSource, bool hevc)
+			: FramedFilter(env, inputSource), m_hevc(hevc), m_waiting(true), m_dropped(0) {}
+
+		virtual void doGetNextFrame() {
+			if (fInputSource != NULL) {
+				fInputSource->getNextFrame(fTo, fMaxSize, afterGettingFrame, this, FramedSource::handleClosure, this);
+			}
+		}
+
+	private:
+		static void afterGettingFrame(void* clientData, unsigned frameSize, unsigned numTruncatedBytes,
+					      struct timeval presentationTime, unsigned durationInMicroseconds) {
+			((WaitForIRAPFilter*)clientData)->afterGettingFrame(frameSize, numTruncatedBytes, presentationTime, durationInMicroseconds);
+		}
+
+		void afterGettingFrame(unsigned frameSize, unsigned numTruncatedBytes, struct timeval presentationTime, unsigned durationInMicroseconds) {
+			if (m_waiting && frameSize > 0) {
+				// frames arrive one NAL unit at a time, without start code
+				unsigned char b = fTo[0];
+				bool slice, irap;
+				if (m_hevc) {
+					int t = (b & 0x7E) >> 1;
+					slice = t < 32;               // VCL
+					irap = (t >= 16 && t <= 21);  // BLA/IDR/CRA
+				} else {
+					int t = b & 0x1F;
+					slice = (t >= 1 && t <= 5);
+					irap = (t == 5);
+				}
+				if (slice && !irap) {
+					m_dropped++;
+					doGetNextFrame();
+					return;
+				}
+				if (irap) {
+					m_waiting = false;
+					LOG(NOTICE) << "RTSP client starts on a keyframe after dropping " << m_dropped << " frame(s)";
+				}
+			}
+			fFrameSize = frameSize;
+			fNumTruncatedBytes = numTruncatedBytes;
+			fPresentationTime = presentationTime;
+			fDurationInMicroseconds = durationInMicroseconds;
+			afterGetting(this);
+		}
+
+		bool m_hevc;
+		bool m_waiting;
+		unsigned m_dropped;
+};
