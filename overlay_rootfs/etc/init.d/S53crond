#!/bin/sh
#
# Start crond
#

start() {
	printf "Starting crond: "
	# -l 9: do not log "USER root pid N cmd ..." for each job; the every-minute watchdogs
	# filled the syslog on the RAM disk and pushed out everything older than a few hours
	/usr/sbin/crond -l 9
	echo "OK"
}

stop() {
	printf "Stopping crond: "
	killall crond
	echo "OK"
}

case "$1" in
  start)
    start
	;;
  stop)
    stop
	;;
  restart|reload)
    stop
    start
	;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit $?
