config BR2_PACKAGE_ONVIF_SIMPLE_SERVER
	bool "onvif_simple_server"
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_MBEDTLS
	select BR2_PACKAGE_ZLIB
	help
	  Lightweight ONVIF Profile S/T server for resource-constrained
	  devices. It provides ONVIF SOAP services as CGI binaries and a
	  small WS-Discovery daemon.
