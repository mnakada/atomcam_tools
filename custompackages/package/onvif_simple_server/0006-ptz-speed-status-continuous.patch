+// largest PanTilt speed component of a <Speed> element, or -1 if there is none
+static double get_pantilt_speed(ezxml_t node)
+{
+    const char *sx = NULL;
+    const char *sy = NULL;
+    double speed = -1.0;
+    ezxml_t pt = get_element_in_element_ptr("PanTilt", node);
+
+    if (pt != NULL) {
+        sx = get_attribute(pt, "x");
+        sy = get_attribute(pt, "y");
+        if (sx != NULL) speed = atof(sx);
+        if ((sy != NULL) && (atof(sy) > speed)) speed = atof(sy);
+    }
+    return speed;
+}
